<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="com.training.exer1candelaria.controller.MainView" displayBlock="true">
   
    <Page id="page" title="{i18n>title}" floatingFooter="true">
        <VBox id="idVBox" class="sapUiSmallMargin">
            <f:SimpleForm id="idSimpleForm" editable="true" layout="ResponsiveGridLayout" title="Details" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">
                <f:content>
                    <Label id="idLblFName" text="{i18n>firstNameLbl}" />
                    <Input id="idInptFName" value=""/>
                    <Label id="idLblLName" text="{i18n>lastNameLbl}"/>
                    <Input id="idInptLName" value=""/>
                    <Label id="idLblMOP" text="{i18n>mopLbl}"/>
                    <Select id="idSelMOP" forceSelection="false" change="onChangeMOP" tooltip="Choose Mode of Payment">
                        <items>
                            <core:Item id="idItmCOD" text="{i18n>codOption}" key="COD"/>
                            <core:Item id="idItmCC" text="{i18n>ccOption}" key="CC"/>
                            <core:Item id="idItmGCash" text="{i18n>gcashOption}" key="GCASH"/>
                        </items>
                    </Select>
                    <Label id="idLblPhone" text="{i18n>mobileLbl}" visible="false"/>
                    <Input id="idInputPhone" value="" visible="false"/>
                    <Label id="idLblCC" text="{i18n>ccLbl}" visible="false"/>
                    <Input id="idInputCC" value="" visible="false"/>
                </f:content>
            </f:SimpleForm>
        </VBox>

